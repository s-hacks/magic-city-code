{
  "name": "@mcc/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "tsc -p . && vite build",
    "build:landing": "tsc -p . && vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-python": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@deck.gl/core": "^9.0",
    "@deck.gl/layers": "^9.0",
    "@deck.gl/mapbox": "^9.0",
    "@lezer/highlight": "^1",
    "@mcc/shared": "workspace:^",
    "codemirror": "^6",
    "maplibre-gl": "^4.7",
    "pyodide": "~0.27",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-router-dom": "^6.28",
    "three": "^0.170.0",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4",
    "typescript": "~5.7",
    "vite": "^6",
    "vitest": "^2"
  }
}
